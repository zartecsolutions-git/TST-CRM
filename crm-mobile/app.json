        "backgroundColor": "#3B82F6"
      },
      "package": "com.crm.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d9500a46-1d32-435e-947f-2f23b3c8fce3"
      }
    },
    "owner": "shaijupkt"
  }
